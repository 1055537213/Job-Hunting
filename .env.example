# Job Hunting Agent OpenAI-compatible LLM configuration example.
# The application reads `.env`; this `.env.example` file is only a template.
# Copy it to `.env`, then set the provider label, model, key and base URL.
# Official APIs, local compatible servers and relay gateways use the same fields.
# `.env` is ignored by Git and should never be committed.

# Optional Docker build mirror. Leave unset to use the official Docker Hub image.
# JOB_AGENT_DOCKER_BASE_IMAGE=dockerproxy.net/library/python:3.12-slim

JOB_AGENT_LLM_PROVIDER=your-chat-provider
JOB_AGENT_LLM_MODEL=your-chat-model
JOB_AGENT_LLM_API_KEY=your-api-key-here
JOB_AGENT_LLM_BASE_URL=https://api.example.com/v1
JOB_AGENT_LLM_TIMEOUT_SECONDS=60
JOB_AGENT_LLM_THINKING=enabled
JOB_AGENT_LLM_REASONING_EFFORT=high

# Internal Model Gateway runtime policy. Development is the default for local use;
# set production only after HTTPS, secure cookies and production infrastructure are ready.
JOB_AGENT_ENVIRONMENT=development
JOB_AGENT_MODEL_GATEWAY_CHAT_MAX_RETRIES=2
JOB_AGENT_MODEL_GATEWAY_EMBEDDING_MAX_RETRIES=2
JOB_AGENT_MODEL_GATEWAY_RERANK_MAX_RETRIES=2
# 语义方向匹配会调用 Embedding/Rerank；离线开发默认关闭，确认接口配置后改为 true。
JOB_AGENT_MATCHING_SEMANTIC=false

# Generic relay example:
# JOB_AGENT_LLM_PROVIDER=my-relay
# JOB_AGENT_LLM_MODEL=provider-model-name
# JOB_AGENT_LLM_API_KEY=your-relay-key
# JOB_AGENT_LLM_BASE_URL=https://relay.example.com/v1
# JOB_AGENT_LLM_THINKING=
# JOB_AGENT_LLM_REASONING_EFFORT=

# Default local embedding configuration for offline/demo use.
JOB_AGENT_EMBEDDING_PROVIDER=local_hash
JOB_AGENT_EMBEDDING_API_STYLE=local_hash
JOB_AGENT_EMBEDDING_MODEL=local-hash
JOB_AGENT_EMBEDDING_TIMEOUT_SECONDS=60
JOB_AGENT_EMBEDDING_BATCH_SIZE=64
# JOB_AGENT_EMBEDDING_DIMENSIONS=1024

# Optional real OpenAI-compatible embedding configuration for RAG:
# JOB_AGENT_EMBEDDING_PROVIDER=openai_compatible
# JOB_AGENT_EMBEDDING_API_STYLE=openai_compatible
# JOB_AGENT_EMBEDDING_MODEL=your-embedding-model
# JOB_AGENT_EMBEDDING_API_KEY=your-embedding-api-key-here
# JOB_AGENT_EMBEDDING_BASE_URL=https://api.example.com/v1
# JOB_AGENT_EMBEDDING_TIMEOUT_SECONDS=60
# JOB_AGENT_EMBEDDING_BATCH_SIZE=64

# Optional provider-native multimodal embedding configuration:
# JOB_AGENT_EMBEDDING_PROVIDER=your-embedding-provider
# JOB_AGENT_EMBEDDING_API_STYLE=native_multimodal
# JOB_AGENT_EMBEDDING_MODEL=your-embedding-model
# JOB_AGENT_EMBEDDING_API_KEY=your-embedding-api-key-here
# JOB_AGENT_EMBEDDING_BASE_URL=https://api.example.com/embedding-endpoint
# JOB_AGENT_EMBEDDING_TIMEOUT_SECONDS=60
# JOB_AGENT_EMBEDDING_BATCH_SIZE=16
#
# Optional Rerank configuration. Rerank has no universal wire format, so choose
# `standard` for a common /rerank endpoint or `native` for a provider-native endpoint.
# JOB_AGENT_RERANK_PROVIDER=your-rerank-provider
# JOB_AGENT_RERANK_API_STYLE=standard
# JOB_AGENT_RERANK_MODEL=your-rerank-model
# JOB_AGENT_RERANK_API_KEY=your-rerank-api-key-here
# JOB_AGENT_RERANK_BASE_URL=https://api.example.com/v1
# JOB_AGENT_RERANK_TIMEOUT_SECONDS=60
# JOB_AGENT_RERANK_CANDIDATE_MULTIPLIER=4

# Optional: persistent chat memory and automatic context summarization.
JOB_AGENT_MEMORY_ENABLED=true
JOB_AGENT_MEMORY_RESTORE_HISTORY_LIMIT=200
JOB_AGENT_MEMORY_RESTORE_TRIGGER_TOKENS=12000
JOB_AGENT_MEMORY_RESTORE_KEEP_MESSAGES=24
JOB_AGENT_MEMORY_RESTORE_SUMMARY_CHARS=6000
JOB_AGENT_MEMORY_SUMMARY_TRIGGER_TOKENS=12000
JOB_AGENT_MEMORY_SUMMARY_KEEP_MESSAGES=24
JOB_AGENT_MEMORY_SUMMARY_TRIM_TOKENS=6000

# 本地开发使用 HTTP 时保持 false；部署到 HTTPS 时改为 true。
JOB_AGENT_COOKIE_SECURE=false
