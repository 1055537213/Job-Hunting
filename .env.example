# Job Hunting Agent OpenAI-compatible LLM configuration example.
# The application reads `.env`; this `.env.example` file is only a template.
# Copy it to `.env`, then set the provider label, model, key and base URL.
# Official APIs, local compatible servers and relay gateways use the same fields.
# `.env` is ignored by Git and should never be committed.

# Optional Docker build mirror. Leave unset to use the official Docker Hub image.
# JOB_AGENT_DOCKER_BASE_IMAGE=dockerproxy.net/library/python:3.12.13-slim
# Optional local PostgreSQL image mirror when Docker Hub is unreachable.
# JOB_AGENT_POSTGRES_IMAGE=dockerproxy.net/pgvector/pgvector:pg16
# Optional Redis image mirror when Docker Hub is unreachable.
# JOB_AGENT_REDIS_IMAGE=dockerproxy.net/library/redis:7.4-alpine
# Optional Prometheus runtime settings. Its Web page stays bound to host loopback.
# JOB_AGENT_PROMETHEUS_IMAGE=prom/prometheus:v3.13.1
# JOB_AGENT_PROMETHEUS_PORT=9090
# JOB_AGENT_PROMETHEUS_RETENTION=15d

# The Web service requires PostgreSQL + pgvector. This host-side address is used
# for direct Python commands after `docker compose up -d` starts PostgreSQL.
# Docker Compose overrides it internally with the `postgres` service hostname.
JOB_AGENT_DATABASE_URL=postgresql+psycopg://job_agent@127.0.0.1:5432/job_agent

# Resume originals and generated DOCX/PDF files use S3-compatible object storage.
# For local Docker development, MinIO exposes its API on the host loopback address.
# Docker Compose changes only the endpoint to http://minio:9000 inside its network.
# Replace all access values with Secret-managed values before production deployment.
# JOB_AGENT_MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z
JOB_AGENT_OBJECT_STORAGE_BACKEND=s3
JOB_AGENT_OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
JOB_AGENT_OBJECT_STORAGE_BUCKET=job-agent-files
JOB_AGENT_OBJECT_STORAGE_ACCESS_KEY=replace-with-minio-access-key
JOB_AGENT_OBJECT_STORAGE_SECRET_KEY=replace-with-a-strong-minio-secret
JOB_AGENT_OBJECT_STORAGE_REGION=us-east-1
JOB_AGENT_OBJECT_STORAGE_FORCE_PATH_STYLE=true
# Local MinIO may create the development bucket on startup; production should pre-create it.
JOB_AGENT_OBJECT_STORAGE_AUTO_CREATE_BUCKET=true

# Docker Compose enables the Redis/Celery worker path inside containers. Direct host-side
# development remains disabled unless Redis is running and these values are configured.
# JOB_AGENT_TASK_QUEUE_ENABLED=true
# JOB_AGENT_REDIS_URL=redis://:replace-with-a-strong-password@127.0.0.1:6379/0
# JOB_AGENT_REDIS_PASSWORD=replace-with-a-strong-redis-password
# JOB_AGENT_TASK_QUEUE_NAME=job_agent
# JOB_AGENT_TASK_TIME_LIMIT_SECONDS=900
# JOB_AGENT_TASK_SOFT_TIME_LIMIT_SECONDS=840

# Optional real-time balance billing configuration.
# The price is yuan per one million tokens. New accounts start at zero by default.
# JOB_AGENT_BILLING_PRICE_PER_MILLION_TOKENS_YUAN=25
# JOB_AGENT_BILLING_STARTING_BALANCE_YUAN=0
# JOB_AGENT_BILLING_LOW_BALANCE_THRESHOLD_YUAN=10

# Optional one-time administrator bootstrap. Set both values before the first Web
# startup, log in once, then remove the password from the real .env file.
# JOB_AGENT_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# JOB_AGENT_BOOTSTRAP_ADMIN_PASSWORD=choose-a-strong-password
# JOB_AGENT_BOOTSTRAP_ADMIN_DISPLAY_NAME=Administrator

JOB_AGENT_LLM_PROVIDER=your-chat-provider
JOB_AGENT_LLM_MODEL=your-chat-model
JOB_AGENT_LLM_API_KEY=your-api-key-here
JOB_AGENT_LLM_BASE_URL=https://api.example.com/v1
JOB_AGENT_LLM_TIMEOUT_SECONDS=60
# 职位截图导入复用此聊天模型；要启用截图识别，请选择支持 image_url 图片输入的多模态模型。
# Provider-specific options. Leave blank unless the selected model documents support.
JOB_AGENT_LLM_ENABLE_THINKING=
# 旧版 DeepSeek 风格字段；已有本地配置可继续使用，新配置优先使用上一行布尔值。
# JOB_AGENT_LLM_THINKING=enabled
JOB_AGENT_LLM_REASONING_EFFORT=

# Internal Model Gateway runtime policy. Development is the default for local use;
# set production only after HTTPS, secure cookies and production infrastructure are ready.
JOB_AGENT_ENVIRONMENT=development
JOB_AGENT_MODEL_GATEWAY_CHAT_MAX_RETRIES=2
JOB_AGENT_MODEL_GATEWAY_EMBEDDING_MAX_RETRIES=2
JOB_AGENT_MODEL_GATEWAY_RERANK_MAX_RETRIES=2
# 连续供应商失败达到阈值后短暂熔断，避免每个请求都等待完整超时。
JOB_AGENT_MODEL_CIRCUIT_FAILURE_THRESHOLD=5
JOB_AGENT_MODEL_CIRCUIT_RECOVERY_SECONDS=30
# 语义方向匹配会调用 Embedding/Rerank；离线开发默认关闭，确认接口配置后改为 true。
JOB_AGENT_MATCHING_SEMANTIC=false

# Generic relay example:
# JOB_AGENT_LLM_PROVIDER=my-relay
# JOB_AGENT_LLM_MODEL=provider-model-name
# JOB_AGENT_LLM_API_KEY=your-relay-key
# JOB_AGENT_LLM_BASE_URL=https://relay.example.com/v1
# JOB_AGENT_LLM_ENABLE_THINKING=
# JOB_AGENT_LLM_THINKING=enabled
# JOB_AGENT_LLM_REASONING_EFFORT=

# Default local embedding configuration for offline/demo use.
JOB_AGENT_EMBEDDING_PROVIDER=local_hash
JOB_AGENT_EMBEDDING_API_STYLE=local_hash
JOB_AGENT_EMBEDDING_MODEL=local-hash
JOB_AGENT_EMBEDDING_TIMEOUT_SECONDS=60
JOB_AGENT_EMBEDDING_BATCH_SIZE=64
# JOB_AGENT_EMBEDDING_DIMENSIONS=1024

# Optional real OpenAI-compatible embedding configuration for RAG:
# JOB_AGENT_EMBEDDING_PROVIDER=openai_compatible
# JOB_AGENT_EMBEDDING_API_STYLE=openai_compatible
# JOB_AGENT_EMBEDDING_MODEL=your-embedding-model
# JOB_AGENT_EMBEDDING_API_KEY=your-embedding-api-key-here
# JOB_AGENT_EMBEDDING_BASE_URL=https://api.example.com/v1
# JOB_AGENT_EMBEDDING_TIMEOUT_SECONDS=60
# JOB_AGENT_EMBEDDING_BATCH_SIZE=64

# Optional provider-native multimodal embedding configuration:
# JOB_AGENT_EMBEDDING_PROVIDER=your-embedding-provider
# JOB_AGENT_EMBEDDING_API_STYLE=native_multimodal
# JOB_AGENT_EMBEDDING_MODEL=your-embedding-model
# JOB_AGENT_EMBEDDING_API_KEY=your-embedding-api-key-here
# JOB_AGENT_EMBEDDING_BASE_URL=https://api.example.com/embedding-endpoint
# JOB_AGENT_EMBEDDING_TIMEOUT_SECONDS=60
# JOB_AGENT_EMBEDDING_BATCH_SIZE=16
#
# Optional Rerank configuration. Rerank has no universal wire format, so choose
# `standard` for a common /rerank endpoint or `native` for a provider-native endpoint.
# JOB_AGENT_RERANK_PROVIDER=your-rerank-provider
# JOB_AGENT_RERANK_API_STYLE=standard
# JOB_AGENT_RERANK_MODEL=your-rerank-model
# JOB_AGENT_RERANK_API_KEY=your-rerank-api-key-here
# JOB_AGENT_RERANK_BASE_URL=https://api.example.com/v1
# JOB_AGENT_RERANK_TIMEOUT_SECONDS=60
# JOB_AGENT_RERANK_CANDIDATE_MULTIPLIER=4

# Optional: persistent chat memory and automatic context summarization.
JOB_AGENT_MEMORY_ENABLED=true
# Docker/生产使用 database，让多个 Web 副本从 PostgreSQL 恢复同一会话上下文。
JOB_AGENT_MEMORY_CHECKPOINT_BACKEND=database
JOB_AGENT_MEMORY_RESTORE_HISTORY_LIMIT=200
JOB_AGENT_MEMORY_RESTORE_TRIGGER_TOKENS=12000
JOB_AGENT_MEMORY_RESTORE_KEEP_MESSAGES=24
JOB_AGENT_MEMORY_RESTORE_SUMMARY_CHARS=6000
JOB_AGENT_MEMORY_SUMMARY_TRIGGER_TOKENS=12000
JOB_AGENT_MEMORY_SUMMARY_KEEP_MESSAGES=24
JOB_AGENT_MEMORY_SUMMARY_TRIM_TOKENS=6000

# 本地开发使用 HTTP 时保持 false；部署到 HTTPS 时改为 true。
JOB_AGENT_COOKIE_SECURE=false

# Web 边缘安全和基础限流。生产环境保持开启；如需兼容非浏览器脚本客户端，应改为先获取
# job_agent_csrf cookie，再在 POST/PUT/DELETE 请求中传入 X-CSRF-Token。
JOB_AGENT_CSRF_ENABLED=true
JOB_AGENT_SECURITY_HEADERS_ENABLED=true
JOB_AGENT_RATE_LIMIT_ENABLED=true
JOB_AGENT_RATE_LIMIT_BACKEND=memory
# 宿主机直接运行 Web 并需要多进程共享限流时，启用 Redis 后端并使用独立数据库 1。
# JOB_AGENT_RATE_LIMIT_REDIS_URL=redis://:replace-with-a-strong-password@127.0.0.1:6379/1
JOB_AGENT_RATE_LIMIT_REDIS_TIMEOUT_SECONDS=1
JOB_AGENT_RATE_LIMIT_KEY_PREFIX=job_agent:rate_limit
JOB_AGENT_RATE_LIMIT_WINDOW_SECONDS=60
JOB_AGENT_RATE_LIMIT_DEFAULT_REQUESTS=240
JOB_AGENT_RATE_LIMIT_AUTH_REQUESTS=20
JOB_AGENT_RATE_LIMIT_MODEL_REQUESTS=60
JOB_AGENT_RATE_LIMIT_UPLOAD_REQUESTS=20
JOB_AGENT_RATE_LIMIT_ADMIN_REQUESTS=120
JOB_AGENT_RATE_LIMIT_WRITE_REQUESTS=120

# 模型/截图共享并发租约。宿主机直接运行默认使用 memory；Docker 与生产使用 Redis DB 1。
JOB_AGENT_CONCURRENCY_ENABLED=true
JOB_AGENT_CONCURRENCY_BACKEND=memory
# JOB_AGENT_CONCURRENCY_REDIS_URL=redis://:replace-with-a-strong-password@127.0.0.1:6379/1
JOB_AGENT_CONCURRENCY_REDIS_TIMEOUT_SECONDS=1
JOB_AGENT_CONCURRENCY_KEY_PREFIX=job_agent:concurrency
JOB_AGENT_MODEL_GLOBAL_CONCURRENCY=8
JOB_AGENT_MODEL_ACCOUNT_CONCURRENCY=2
JOB_AGENT_SCREENSHOT_GLOBAL_CONCURRENCY=2
JOB_AGENT_SCREENSHOT_ACCOUNT_CONCURRENCY=1
JOB_AGENT_CONCURRENCY_LEASE_TTL_SECONDS=900
JOB_AGENT_CONCURRENCY_WAIT_TIMEOUT_SECONDS=5
