# Job Hunting Agent OpenAI-compatible LLM configuration example.
# The application reads `.env`; this `.env.example` file is only a template.
# Copy it to `.env`, then set the provider label, model, key and base URL.
# Official APIs, local compatible servers and relay gateways use the same fields.
# `.env` is ignored by Git and should never be committed.

JOB_AGENT_LLM_PROVIDER=deepseek
JOB_AGENT_LLM_MODEL=deepseek-v4-pro
JOB_AGENT_LLM_API_KEY=your-api-key-here
JOB_AGENT_LLM_BASE_URL=https://api.deepseek.com
JOB_AGENT_LLM_TIMEOUT_SECONDS=60
JOB_AGENT_LLM_THINKING=enabled
JOB_AGENT_LLM_REASONING_EFFORT=high

# Generic relay example:
# JOB_AGENT_LLM_PROVIDER=my-relay
# JOB_AGENT_LLM_MODEL=provider-model-name
# JOB_AGENT_LLM_API_KEY=your-relay-key
# JOB_AGENT_LLM_BASE_URL=https://relay.example.com/v1
# JOB_AGENT_LLM_THINKING=
# JOB_AGENT_LLM_REASONING_EFFORT=

# Optional: real embedding configuration for RAG.
# If omitted, the project falls back to local hash embeddings for offline/demo use.
JOB_AGENT_EMBEDDING_PROVIDER=openai_compatible
JOB_AGENT_EMBEDDING_MODEL=text-embedding-3-small
JOB_AGENT_EMBEDDING_API_KEY=your-embedding-api-key-here
JOB_AGENT_EMBEDDING_BASE_URL=https://api.openai.com/v1
JOB_AGENT_EMBEDDING_TIMEOUT_SECONDS=60
JOB_AGENT_EMBEDDING_BATCH_SIZE=64
# JOB_AGENT_EMBEDDING_DIMENSIONS=1024

# Optional: persistent chat memory and automatic context summarization.
JOB_AGENT_MEMORY_ENABLED=true
JOB_AGENT_MEMORY_RESTORE_HISTORY_LIMIT=200
JOB_AGENT_MEMORY_RESTORE_TRIGGER_TOKENS=12000
JOB_AGENT_MEMORY_RESTORE_KEEP_MESSAGES=24
JOB_AGENT_MEMORY_RESTORE_SUMMARY_CHARS=6000
JOB_AGENT_MEMORY_SUMMARY_TRIGGER_TOKENS=12000
JOB_AGENT_MEMORY_SUMMARY_KEEP_MESSAGES=24
JOB_AGENT_MEMORY_SUMMARY_TRIM_TOKENS=6000

# 本地开发使用 HTTP 时保持 false；部署到 HTTPS 时改为 true。
JOB_AGENT_COOKIE_SECURE=false
