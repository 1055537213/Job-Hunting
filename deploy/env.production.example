# 生产环境配置模板。请先复制 .env.example 的模型和业务配置，再用本文件覆盖部署项。
# 这个文件不包含真实密钥；生产密钥应由部署平台 Secret 或受限权限的 .env 提供。

JOB_AGENT_ENVIRONMENT=production
JOB_AGENT_COOKIE_SECURE=true
# compose.prod.yaml 只在内部网络开放 Web，并据此配置 Uvicorn 信任 Caddy 代理地址。
JOB_AGENT_CSRF_ENABLED=true
JOB_AGENT_SECURITY_HEADERS_ENABLED=true
JOB_AGENT_RATE_LIMIT_ENABLED=true
JOB_AGENT_RATE_LIMIT_BACKEND=redis
JOB_AGENT_RATE_LIMIT_REDIS_TIMEOUT_SECONDS=1
JOB_AGENT_RATE_LIMIT_WINDOW_SECONDS=60
JOB_AGENT_RATE_LIMIT_DEFAULT_REQUESTS=240
JOB_AGENT_RATE_LIMIT_AUTH_REQUESTS=20
JOB_AGENT_RATE_LIMIT_MODEL_REQUESTS=60
JOB_AGENT_RATE_LIMIT_UPLOAD_REQUESTS=20
JOB_AGENT_RATE_LIMIT_ADMIN_REQUESTS=120
JOB_AGENT_RATE_LIMIT_WRITE_REQUESTS=120
JOB_AGENT_CONCURRENCY_ENABLED=true
JOB_AGENT_CONCURRENCY_BACKEND=redis
JOB_AGENT_CONCURRENCY_REDIS_TIMEOUT_SECONDS=1
JOB_AGENT_MODEL_GLOBAL_CONCURRENCY=8
JOB_AGENT_MODEL_ACCOUNT_CONCURRENCY=2
JOB_AGENT_SCREENSHOT_GLOBAL_CONCURRENCY=2
JOB_AGENT_SCREENSHOT_ACCOUNT_CONCURRENCY=1
JOB_AGENT_CONCURRENCY_LEASE_TTL_SECONDS=900
JOB_AGENT_CONCURRENCY_WAIT_TIMEOUT_SECONDS=5

# JOB_AGENT_IMAGE 应指向已经通过 CI 构建并扫描的不可变镜像标签。
JOB_AGENT_IMAGE=ghcr.io/your-org/job-hunting-agent:replace-with-release-tag
JOB_AGENT_DOMAIN=agent.example.com
JOB_AGENT_TLS_EMAIL=ops@example.com

# 注册、验证和找回密码。PUBLIC_BASE_URL 必须和 Caddy 对外域名一致。
JOB_AGENT_REGISTRATION_ENABLED=true
JOB_AGENT_EMAIL_VERIFICATION_REQUIRED=true
JOB_AGENT_CONSENT_REQUIRED=true
JOB_AGENT_PUBLIC_BASE_URL=https://agent.example.com
JOB_AGENT_ACCOUNT_EMAIL_BACKEND=smtp
JOB_AGENT_ACCOUNT_ACTION_SECRET=replace-with-at-least-32-random-characters
JOB_AGENT_ACCOUNT_EMAIL_COOLDOWN_SECONDS=60
JOB_AGENT_ACCOUNT_EMAIL_HOURLY_LIMIT=5
JOB_AGENT_ACCOUNT_EMAIL_SOURCE_HOURLY_LIMIT=20
JOB_AGENT_ACCOUNT_EMAIL_MAX_ATTEMPTS=5
JOB_AGENT_ACCOUNT_EMAIL_RETRY_BASE_SECONDS=30
JOB_AGENT_ACCOUNT_EMAIL_CLAIM_TIMEOUT_SECONDS=300
JOB_AGENT_ACCOUNT_EMAIL_RETENTION_DAYS=14
JOB_AGENT_SMTP_HOST=smtp.example.com
JOB_AGENT_SMTP_PORT=587
JOB_AGENT_SMTP_USERNAME=replace-with-smtp-user
JOB_AGENT_SMTP_PASSWORD=replace-with-smtp-password
JOB_AGENT_SMTP_FROM_EMAIL=no-reply@example.com
JOB_AGENT_SMTP_USE_STARTTLS=true
JOB_AGENT_VERIFICATION_TOKEN_TTL_MINUTES=1440
JOB_AGENT_PASSWORD_RESET_TOKEN_TTL_MINUTES=30
JOB_AGENT_TERMS_VERSION=2026-08-26
JOB_AGENT_PRIVACY_VERSION=2026-08-26

# 密码只使用 URL-safe 字符，避免直接拼接 PostgreSQL URL 时产生解析歧义。
JOB_AGENT_POSTGRES_DB=job_agent
JOB_AGENT_POSTGRES_USER=job_agent
JOB_AGENT_POSTGRES_PASSWORD=replace-with-a-long-url-safe-password
JOB_AGENT_REDIS_PASSWORD=replace-with-a-long-redis-password

# Prometheus 页面只绑定服务器回环地址。生产运维可通过 SSH 端口转发访问。
JOB_AGENT_PROMETHEUS_IMAGE=prom/prometheus:v3.13.1
JOB_AGENT_PROMETHEUS_PORT=9090
JOB_AGENT_PROMETHEUS_RETENTION=15d

# 生产对象存储 bucket 必须提前创建，并关闭应用自动创建。
JOB_AGENT_OBJECT_STORAGE_BACKEND=s3
JOB_AGENT_OBJECT_STORAGE_BUCKET=job-agent-files
JOB_AGENT_OBJECT_STORAGE_AUTO_CREATE_BUCKET=false
JOB_AGENT_OBJECT_STORAGE_ACCESS_KEY=replace-with-object-storage-access-key
JOB_AGENT_OBJECT_STORAGE_SECRET_KEY=replace-with-object-storage-secret
