# 生产环境配置模板。请先复制 .env.example 的模型和业务配置，再用本文件覆盖部署项。
# 这个文件不包含真实密钥；生产密钥应由部署平台 Secret 或受限权限的 .env 提供。

JOB_AGENT_ENVIRONMENT=production
JOB_AGENT_COOKIE_SECURE=true
JOB_AGENT_CSRF_ENABLED=true
JOB_AGENT_SECURITY_HEADERS_ENABLED=true
JOB_AGENT_RATE_LIMIT_ENABLED=true

# JOB_AGENT_IMAGE 应指向已经通过 CI 构建并扫描的不可变镜像标签。
JOB_AGENT_IMAGE=ghcr.io/your-org/job-hunting-agent:replace-with-release-tag
JOB_AGENT_DOMAIN=agent.example.com
JOB_AGENT_TLS_EMAIL=ops@example.com

# 密码只使用 URL-safe 字符，避免直接拼接 PostgreSQL URL 时产生解析歧义。
JOB_AGENT_POSTGRES_DB=job_agent
JOB_AGENT_POSTGRES_USER=job_agent
JOB_AGENT_POSTGRES_PASSWORD=replace-with-a-long-url-safe-password
JOB_AGENT_REDIS_PASSWORD=replace-with-a-long-redis-password

# 生产对象存储 bucket 必须提前创建，并关闭应用自动创建。
JOB_AGENT_OBJECT_STORAGE_BACKEND=s3
JOB_AGENT_OBJECT_STORAGE_BUCKET=job-agent-files
JOB_AGENT_OBJECT_STORAGE_AUTO_CREATE_BUCKET=false
JOB_AGENT_OBJECT_STORAGE_ACCESS_KEY=replace-with-object-storage-access-key
JOB_AGENT_OBJECT_STORAGE_SECRET_KEY=replace-with-object-storage-secret
