{
	email {$JOB_AGENT_TLS_EMAIL}
}

{$JOB_AGENT_DOMAIN} {
	encode gzip

	request_body {
		max_size 25MB
	}

	route {
		# 指标只允许 Compose 内部的 Prometheus 访问，不经公网反向代理暴露。
		@internal path /internal/*
		respond @internal 404

		# 已迁移的同源认证写接口由 Java 平台服务直接处理；其余外部 API
		# 继续进入 Python，便于逐条迁移并保持失败时可回滚。
		@platform_auth path /api/auth/login /api/auth/logout /api/auth/logout-all /api/account/password
		reverse_proxy @platform_auth platform-service:8081

		# Docker DNS 会为扩容后的 web 服务返回全部容器地址。Caddy 动态刷新地址并轮询，
		# 避免在容器重建后继续使用旧 IP，也避免全部请求固定落到单个副本。
		reverse_proxy {
			dynamic a web 8000 {
				refresh 5s
				versions ipv4
			}
			lb_policy round_robin
			lb_try_duration 5s
			lb_try_interval 250ms
		}
	}
}
