{
	email {$JOB_AGENT_TLS_EMAIL}
}

{$JOB_AGENT_DOMAIN} {
	encode gzip

	request_body {
		max_size 25MB
	}

	route {
		# 指标只允许 Compose 内部的 Prometheus 访问，不经公网反向代理暴露。
		@internal path /internal/*
		respond @internal 404

		# Docker DNS 会为扩容后的 web 服务返回全部容器地址。Caddy 动态刷新地址并轮询，
		# 避免在容器重建后继续使用旧 IP，也避免全部请求固定落到单个副本。
		reverse_proxy {
			dynamic a web 8000 {
				refresh 5s
				versions ipv4
			}
			lb_policy round_robin
			lb_try_duration 5s
			lb_try_interval 250ms
		}
	}
}
