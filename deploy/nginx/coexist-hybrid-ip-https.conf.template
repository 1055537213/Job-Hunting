map $http_upgrade $connection_upgrade {
    default upgrade;
    "" close;
}

server {
    listen 8443 ssl;
    listen [::]:8443 ssl;
    server_name ${JOB_AGENT_PUBLIC_IP};
    server_tokens off;

    ssl_certificate /etc/letsencrypt/live/${JOB_AGENT_PUBLIC_IP}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${JOB_AGENT_PUBLIC_IP}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    client_max_body_size 300m;

    location ^~ /internal/ {
        return 404;
    }

    location ^~ /api/auth/ {
        proxy_pass http://platform-service:8081;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
    }

    location = /api/account/password {
        proxy_pass http://platform-service:8081;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
    }

    location ~ ^/api/account/(profile|email)$ {
        error_page 418 = @python_task_write;
        if ($request_method != PATCH) { return 418; }
        proxy_pass http://platform-service:8081;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_cache off;
        proxy_read_timeout 30s;
    }

    location = /api/account/delete {
        error_page 418 = @python_task_write;
        if ($request_method != POST) { return 418; }
        proxy_pass http://platform-service:8081;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_cache off;
        proxy_read_timeout 30s;
    }

    location = /api/account/export {
        error_page 418 = @python_task_write;
        if ($request_method != GET) { return 418; }
        proxy_pass http://platform-service:8081;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 40s;
    }

    location = /api/profiles {
        error_page 418 = @python_task_write;
        if ($request_method !~ ^(GET|POST)$) { return 418; }
        proxy_pass http://platform-service:8081;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_cache off;
        proxy_read_timeout 5s;
    }

    location ~ ^/api/profiles/[^/]+$ {
        error_page 418 = @python_task_write;
        if ($request_method !~ ^(GET|DELETE)$) { return 418; }
        proxy_pass http://platform-service:8081;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_cache off;
        proxy_read_timeout 5s;
    }

    location = /api/chat {
        error_page 418 = @python_task_write;
        if ($request_method != POST) { return 418; }
        proxy_pass http://platform-service:8081;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_cache off;
        proxy_next_upstream off;
        proxy_read_timeout 330s;
    }

    location = /api/chat/stream {
        error_page 418 = @python_task_write;
        if ($request_method != POST) { return 418; }
        proxy_pass http://platform-service:8081;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
        proxy_cache off;
        proxy_next_upstream off;
        proxy_ignore_client_abort off;
        proxy_read_timeout 330s;
    }

    location ~ ^/api/chat/(sessions(/[^/]+(/archive)?)?|history)$ {
        error_page 418 = @python_task_write;
        if ($request_method !~ ^(GET|POST|DELETE)$) { return 418; }
        proxy_pass http://platform-service:8081;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_cache off;
        proxy_read_timeout 30s;
    }

    location = /api/me/balance/recharge {
        proxy_pass http://platform-service:8081;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_cache off;
        proxy_read_timeout 300s;
    }

    location = /api/me/balance {
        proxy_pass http://platform-service:8081;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_cache off;
        proxy_read_timeout 300s;
    }

    location = /api/me/recharge/orders {
        proxy_pass http://platform-service:8081;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_cache off;
        proxy_read_timeout 300s;
    }

    location ~ "^/api/payments/webhooks/[a-z0-9_-]{1,32}$" {
        if ($request_method != POST) { return 405; }
        proxy_pass http://platform-service:8081;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 30s;
    }

    location ~ ^/api/admin/(balance/events|recharge/orders|recharge/orders/[0-9]+/events|recharge/reconciliation|accounts/[0-9]+/balance/credit)$ {
        proxy_pass http://platform-service:8081;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_cache off;
        proxy_read_timeout 300s;
    }

    location ~ ^/api/admin/recharge/orders/[0-9]+/refund$ {
        if ($request_method != POST) { return 405; }
        proxy_pass http://platform-service:8081;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_cache off;
        proxy_read_timeout 300s;
    }

    location ~ ^/api/admin/(accounts|audit/events|accounts/[0-9]+/status)$ {
        proxy_pass http://platform-service:8081;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_cache off;
        proxy_read_timeout 300s;
    }

    location ~ ^/api/admin/usage/(summary|events)$ {
        proxy_pass http://platform-service:8081;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_cache off;
        proxy_read_timeout 300s;
    }

    location = /api/admin/observability/requests {
        proxy_pass http://platform-service:8081;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_cache off;
        proxy_read_timeout 10s;
    }

    location ~ ^/api/admin/tools/traces(/[^/]+)?$ {
        proxy_pass http://platform-service:8081;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_cache off;
        proxy_read_timeout 300s;
    }

    location ~ ^/api/admin/tasks/(probe|[^/]+/retry)$ {
        error_page 418 = @python_task_write;
        if ($request_method != POST) { return 418; }
        proxy_pass http://platform-service:8081;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_cache off;
        proxy_read_timeout 30s;
    }

    location ~ ^/api/(admin/tasks|tasks/[^/]+)$ {
        # Write routes (retry/probe) stay on Python, including unsupported methods on this path.
        error_page 418 = @python_task_write;
        if ($request_method != GET) { return 418; }
        proxy_pass http://platform-service:8081;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_cache off;
        proxy_read_timeout 300s;
    }

    location @python_task_write {
        proxy_pass http://web:8000;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
        proxy_read_timeout 300s;
    }

    location / {
        proxy_pass http://web:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;
        proxy_cache off;
        proxy_request_buffering off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }
}
