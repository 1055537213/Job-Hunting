{
	email {$JOB_AGENT_TLS_EMAIL}
}

{$JOB_AGENT_DOMAIN} {
	encode gzip
	request_body {
		max_size 25MB
	}
	route {
		@internal path /internal/*
		respond @internal 404

		@browser_auth path /api/auth/* /api/account/password
		reverse_proxy @browser_auth platform-service:8081
		@billing_reads {
			method GET
			path /api/me/balance /api/me/recharge/orders
		}
		reverse_proxy @billing_reads platform-service:8081

		reverse_proxy {
			dynamic a web 8000 {
				refresh 5s
				versions ipv4
			}
			lb_policy round_robin
			lb_try_duration 5s
			lb_try_interval 250ms
		}
	}
}
