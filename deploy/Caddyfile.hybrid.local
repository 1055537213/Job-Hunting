:8080 {
	route {
		@internal path /internal/*
		respond @internal 404
		@browser_auth path /api/auth/* /api/account/password
		reverse_proxy @browser_auth platform-service:8081
		@account_profile {
			method PATCH
			path /api/account/profile /api/account/email
		}
		reverse_proxy @account_profile platform-service:8081
		@account_export {
			method GET
			path /api/account/export
		}
		reverse_proxy @account_export platform-service:8081
		@profile_reads {
			method GET
			path_regexp profileReads ^/api/profiles(/[^/]+)?$
		}
		reverse_proxy @profile_reads platform-service:8081
		@profile_create {
			method POST
			path /api/profiles
		}
		reverse_proxy @profile_create platform-service:8081
		@profile_delete {
			method DELETE
			path_regexp profileDelete ^/api/profiles/[^/]+$
		}
		reverse_proxy @profile_delete platform-service:8081
		@chat_management {
			method GET POST DELETE
			path_regexp chatManagement ^/api/chat/(sessions(/[^/]+(/archive)?)?|history)$
		}
		reverse_proxy @chat_management platform-service:8081
		@chat_message {
			method POST
			path /api/chat /api/chat/stream
		}
		reverse_proxy @chat_message platform-service:8081 {
			transport http {
				response_header_timeout 330s
			}
		}
		@project_list {
			method GET
			path /api/projects
		}
		reverse_proxy @project_list platform-service:8081
		@project_github {
			method POST
			path /api/projects/github
		}
		reverse_proxy @project_github platform-service:8081
		@job_text_import {
			method POST
			path /api/jobs
		}
		request_body @job_text_import {
			max_size 256KB
		}
		reverse_proxy @job_text_import platform-service:8081
		@job_list {
			method GET
			path /api/jobs
		}
		reverse_proxy @job_list platform-service:8081
		@job_skill_update {
			method PUT
			path_regexp jobSkillUpdate ^/api/jobs/[0-9]+/skill-requirements$
		}
		reverse_proxy @job_skill_update platform-service:8081
		@job_delete {
			method DELETE
			path_regexp jobDelete ^/api/jobs/[0-9]+$
		}
		reverse_proxy @job_delete platform-service:8081
		@resume_upload {
			method POST
			path /api/resumes/upload
		}
		request_body @resume_upload {
			max_size 20MB
		}
		reverse_proxy @resume_upload platform-service:8081 {
			transport http {
				response_header_timeout 300s
			}
		}
		@job_screenshot_upload {
			method POST
			path /api/jobs/screenshots
		}
		request_body @job_screenshot_upload {
			max_size 20MB
		}
		reverse_proxy @job_screenshot_upload platform-service:8081 {
			transport http {
				response_header_timeout 300s
			}
		}
		@local_manifest {
			method POST
			path /api/projects/local/manifest
		}
		request_body @local_manifest {
			max_size 4194304
		}
		reverse_proxy @local_manifest platform-service:8081
		@local_collection {
			method GET DELETE
			path_regexp localCollection ^/api/projects/local/[0-9]+$
		}
		reverse_proxy @local_collection platform-service:8081
		@local_files {
			method POST
			path_regexp localFiles ^/api/projects/local/[0-9]+/files$
		}
		request_body @local_files {
			max_size 167772160
		}
		reverse_proxy @local_files platform-service:8081 {
			transport http {
				response_header_timeout 300s
			}
		}
		@local_complete {
			method POST
			path_regexp localComplete ^/api/projects/local/[0-9]+/complete$
		}
		reverse_proxy @local_complete platform-service:8081
		@project_confirm {
			method POST
			path_regexp projectConfirm ^/api/projects/[0-9]+/confirm$
		}
		reverse_proxy @project_confirm platform-service:8081
		@project_delete {
			method DELETE
			path_regexp projectDelete ^/api/projects/[0-9]+$
		}
		reverse_proxy @project_delete platform-service:8081
		@account_deletion {
			method POST
			path /api/account/delete
		}
		reverse_proxy @account_deletion platform-service:8081
		@billing_reads {
			method GET
			path /api/me/balance /api/me/recharge/orders
		}
		reverse_proxy @billing_reads platform-service:8081
		@personal_recharge {
			method POST
			path /api/me/balance/recharge
		}
		reverse_proxy @personal_recharge platform-service:8081
		@payment_webhook {
			method POST
			path_regexp paymentWebhook ^/api/payments/webhooks/[a-z0-9_-]{1,32}$
		}
		reverse_proxy @payment_webhook platform-service:8081
		@admin_billing_reads {
			method GET
			path_regexp adminBillingReads ^/api/admin/(balance/events|recharge/orders|recharge/orders/[0-9]+/events|recharge/reconciliation)$
		}
		reverse_proxy @admin_billing_reads platform-service:8081
		@admin_refund {
			method POST
			path_regexp adminRefund ^/api/admin/recharge/orders/[0-9]+/refund$
		}
		reverse_proxy @admin_refund platform-service:8081
		@admin_credit {
			method POST
			path_regexp adminCredit ^/api/admin/accounts/[0-9]+/balance/credit$
		}
		reverse_proxy @admin_credit platform-service:8081
		@admin_accounts_read {
			method GET
			path /api/admin/accounts /api/admin/audit/events
		}
		reverse_proxy @admin_accounts_read platform-service:8081
		@admin_account_status {
			method PATCH
			path_regexp adminAccountStatus ^/api/admin/accounts/[0-9]+/status$
		}
		reverse_proxy @admin_account_status platform-service:8081
		@admin_usage {
			method GET
			path /api/admin/usage/summary /api/admin/usage/events
		}
		reverse_proxy @admin_usage platform-service:8081
		@admin_observability {
			method GET
			path /api/admin/observability/requests
		}
		reverse_proxy @admin_observability platform-service:8081
		@admin_tool_traces {
			method GET
			path_regexp adminToolTraces ^/api/admin/tools/traces(/[^/]+)?$
		}
		reverse_proxy @admin_tool_traces platform-service:8081
		@task_reads {
			method GET
			path_regexp taskReads ^/api/(admin/tasks|tasks/[^/]+)$
		}
		reverse_proxy @task_reads platform-service:8081
		@task_commands {
			method POST
			path_regexp taskCommands ^/api/admin/tasks/(probe|[^/]+/retry)$
		}
		reverse_proxy @task_commands platform-service:8081
		reverse_proxy web:8000
	}
}
