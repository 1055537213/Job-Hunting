discovery.docker "production" {
  host = "unix:///var/run/docker.sock"

  filter {
    name   = "label"
    values = ["com.docker.compose.project=job-hunting-agent-production"]
  }
}

discovery.relabel "production_logs" {
  targets = discovery.docker.production.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

loki.source.docker "production" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.production_logs.output
  labels     = {"stack" = "job-hunting-agent"}
  forward_to = [loki.process.application.receiver]
}

loki.process "application" {
  stage.json {
    expressions = {
      environment = "environment",
      level       = "level",
    }
  }

  stage.labels {
    values = {
      environment = "",
      level       = "",
    }
  }

  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

otelcol.receiver.otlp "application" {
  grpc {
    endpoint          = "0.0.0.0:4317"
    max_recv_msg_size = "8MiB"
  }

  http {
    endpoint              = "0.0.0.0:4318"
    max_request_body_size = "8MiB"
  }

  output {
    traces = [otelcol.processor.batch.traces.input]
  }
}

otelcol.processor.batch "traces" {
  timeout         = "5s"
  send_batch_size = 512

  output {
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"

    tls {
      insecure = true
    }
  }
}
